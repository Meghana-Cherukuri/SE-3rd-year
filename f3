import boto3  
dynamodb = boto3.resource('dynamodb')  
table = dynamodb.Table('22bd1a056b_exp9')  
response = table.scan()  
items = response['Items']  
# Sort by name  
sorted_items = sorted(items, key=lambda x: x['name'])  
for i in sorted_items:  
print(i)  
 
We can see the names printed in alphabetical order. 
