The count of the members whose rating is 5 is shown: 

3. Average rating of each subject 
from collections import defaultdict 
subject_rating = defaultdict(list) 
for item in items: 
    subject_rating[item['subject']].append(item['rating']) 
for subject, ratings in subject_rating.items(): 
    avg = sum(ratings) / len(ratings) 
    print(f"{subject} average rating: {avg}") 

